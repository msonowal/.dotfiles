# ============================================================================
# Oh My Zsh
# ============================================================================

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # Using Starship prompt instead

plugins=(
  git
  docker
  docker-compose
  fzf
  zoxide
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# ============================================================================
# PATH
# ============================================================================

export PATH="$HOME/.local/bin:$PATH"
export PATH="$PATH:$HOME/.composer/vendor/bin"

# Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# ============================================================================
# Environment
# ============================================================================

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export EDITOR="vim"

# ============================================================================
# fnm (Fast Node Manager)
# ============================================================================

FNM_PATH="/opt/homebrew/opt/fnm/bin"
if [ -d "$FNM_PATH" ]; then
  eval "$(fnm env)"
fi

# ============================================================================
# fzf
# ============================================================================

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Use fd for file search, bat for preview, Tokyo Night colors
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:500 {}'"
export FZF_DEFAULT_OPTS="
  --height 40% --layout=reverse --border
  --color=bg+:#283457,bg:#16161e,spinner:#bb9af7,hl:#7dcfff
  --color=fg:#c0caf5,header:#7dcfff,info:#7aa2f7,pointer:#bb9af7
  --color=marker:#9ece6a,fg+:#c0caf5,prompt:#7aa2f7,hl+:#7dcfff"

# ============================================================================
# Bun completions
# ============================================================================

[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# ============================================================================
# Aliases
# ============================================================================

# Modern CLI replacements
alias cat='bat --paging=never'
alias ls='eza --icons --group-directories-first'
alias ll='eza --icons --group-directories-first -la'
alias lt='eza --icons --tree --level=2'
alias top='htop'
alias diff='delta'

# Docker
alias docker_p="docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.RunningFor}}\t{{.Image}}\t{{.ID}}'"

# Laravel
alias art='php artisan'
alias artm='php artisan migrate'
alias artmf='php artisan migrate:fresh --seed'
alias tinker='php artisan tinker'
alias sail='[ -f sail ] && sh sail || sh vendor/bin/sail'

# ============================================================================
# Starship prompt (must be at end)
# ============================================================================

eval "$(starship init zsh)"

